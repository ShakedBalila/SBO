DATABASE_URL=postgresql://sbo:sbo_local_change_me@localhost:5432/sbo
# Optional direct PostgreSQL URL used only by migrations (recommended for Supabase).
DIRECT_URL=
POSTGRES_PASSWORD=sbo_local_change_me
# Optional extra trusted origins. Same-origin requests and Vercel URLs are accepted automatically.
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false is necessary for local HTTP; set true behind HTTPS before public use.
COOKIE_SECURE=false
SUPABASE_CA_CERT=

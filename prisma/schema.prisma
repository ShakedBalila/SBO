generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
  CANCELLED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings UserSettings?
  sessions Session[]
  tasks Task[]
  taskEvents TaskEvent[]
  waterEntries WaterEntry[]
  vehicles Vehicle[]
  fuelEntries FuelEntry[]
  nutritionEntries NutritionEntry[]
  userFoods UserFood[]
  foodPreferences FoodPreference[]
  calendarEvents CalendarEvent[]
  eventTypes EventType[]
  vehiclePolicies VehiclePolicy[]
  vehicleReminders VehicleReminder[]
  vehicleExpenses VehicleExpense[]
  workSettings WorkSettings?
  workEntries WorkEntry[]
  workTrips WorkTrip[]
  workExpenses WorkExpense[]
  workDocuments WorkDocument[]
  pushSubscriptions PushSubscription[]
  auditEvents AuditEvent[]
  workoutPlans WorkoutPlan[]
  workoutSessions WorkoutSession[]
  workoutExercises WorkoutExercise[]
  workoutLinks WorkoutLink[]
}
model UserSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStatus String @default("complete") @db.VarChar(12)
  locale String @default("he")
  timezone String @default("Asia/Jerusalem")
  enabledModules String[] @default(["tasks", "water", "car", "nutrition"])
  waterGoalMl Int?
  waterDayStart String @default("08:00") @db.VarChar(5)
  waterDayEnd String @default("20:00") @db.VarChar(5)
  waterPaceIntervalHours Int @default(2)
  waterReminderEnabled Boolean @default(false)
  waterReminderStart String @default("08:00") @db.VarChar(5)
  waterReminderEnd String @default("16:00") @db.VarChar(5)
  waterReminderIntervalMinutes Int @default(60)
  vehicleReminderEnabled Boolean @default(false)
  creatineReminderEnabled Boolean @default(false)
  creatineReminderTime String @default("09:00") @db.VarChar(5)
  creatineDosageText String @default("") @db.VarChar(200)
  calorieGoal Int?
  proteinGoalG Int?
  nutritionGoalMode String @default("auto") @db.VarChar(10)
  age Int?
  sex String? @db.VarChar(10)
  heightCm Int?
  weightKg Decimal? @db.Decimal(6, 2)
  activityLevel String? @db.VarChar(20)
  weeklyWorkouts Int?
  weightGoal String? @db.VarChar(20)
  currency String @default("ILS")
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent String @default("") @db.VarChar(500)
  @@index([userId])
  @@index([expiresAt])
}
model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(5000)
  status TaskStatus @default(IN_PROGRESS)
  priority TaskPriority @default(MEDIUM)
  dueDate DateTime? @db.Date
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  recurrence Recurrence @default(NONE)
  recurrenceDays Int[] @default([])
  recurrenceUntil DateTime? @db.Date
  time String? @db.VarChar(5)
  startTime String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  color String? @db.VarChar(7)
  category String? @db.VarChar(80)
  showOnCalendar Boolean @default(false)
  reminderMinutes Int?
  seriesId String?
  completedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status, dueDate])
  @@index([userId, seriesId])
  @@index([userId, deletedAt])
}
model TaskEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  action String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model LoginAttempt {
  key String @id
  count Int @default(1)
  windowStart DateTime @default(now())
}
model WorkoutPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  version Int @default(1)
  active Boolean @default(false)
  archived Boolean @default(false)
  draft Boolean @default(true)
  content Json
  importKey String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions WorkoutSession[]
  @@unique([id, userId])
  @@unique([userId, importKey])
  @@index([userId, active])
}
model WorkoutSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan WorkoutPlan @relation(fields: [planId, userId], references: [id, userId], onDelete: NoAction)
  dayId String @db.VarChar(80)
  localDate String @db.VarChar(10)
  status String @default("SCHEDULED") @db.VarChar(20)
  snapshot Json
  performed Json
  startedAt DateTime?
  endedAt DateTime?
  pausedAt DateTime?
  pausedSeconds Int @default(0)
  revision Int @default(0)
  notes String @default("") @db.VarChar(2000)
  importKey String? @db.VarChar(64)
  updatedAt DateTime @updatedAt
  @@unique([userId, planId, dayId, localDate])
  @@unique([userId, importKey])
  @@index([userId, localDate])
  @@index([planId, userId])
}
model WorkoutExercise {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(150)
  details Json
  favorite Boolean @default(false)
  image Bytes?
  imageMime String? @db.VarChar(30)
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model WorkoutLink {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKind String @db.VarChar(10)
  sourceId String
  localDate String @db.VarChar(10)
  original Json
  hidden Boolean @default(true)
  @@unique([userId, sourceKind, sourceId])
  @@index([userId, localDate])
}
model WaterEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model Vehicle {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  licensePlate String @default("") @db.VarChar(30)
  year Int?
  roadMonth Int?
  odometerKm Int @default(0)
  fuelTankLiters Decimal? @db.Decimal(8, 1)
  acquisitionDate DateTime? @db.Date
  createdAt DateTime @default(now())
  fuelEntries FuelEntry[]
  policies VehiclePolicy[]
  reminders VehicleReminder[]
  expenses VehicleExpense[]
  @@unique([id, userId])
  @@index([userId])
}
model FuelEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  date DateTime @db.Date
  estimatedRangeKm Int?
  distanceMode String @default("odometer") @db.VarChar(12)
  actualDistanceKm Int?
  distanceStartRefuelId String? @db.VarChar(64)
  distanceSource String? @db.VarChar(24)
  distanceConfirmedAt DateTime?
  clientRequestId String? @db.VarChar(36)
  currentOdometerKm Int?
  liters Decimal @db.Decimal(10, 2)
  pricePerLiter Decimal @db.Decimal(10, 3)
  totalCost Decimal? @db.Decimal(12, 2)
  dashboardKmPerLiter Decimal? @db.Decimal(8, 3)
  isFullTank Boolean?
  notes String @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@unique([userId, clientRequestId])
  @@index([userId, vehicleId, date, createdAt])
  @@index([userId, date])
}
model AuditEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  action String @db.VarChar(80)
  outcome String @default("SUCCESS") @db.VarChar(16)
  entityType String? @db.VarChar(40)
  entityId String? @db.VarChar(64)
  sessionId String? @db.VarChar(64)
  changedFields String[] @default([])
  metadata Json?
  occurredAt DateTime @default(now())
  @@index([userId, occurredAt])
}
model VehiclePolicy {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(20)
  provider String @default("") @db.VarChar(100)
  annualCost Decimal @db.Decimal(12, 2)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reminderDays Int?
  reminderTime String @default("09:00") @db.VarChar(5)
  @@index([userId, endDate])
}
model VehicleReminder {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(20)
  title String @db.VarChar(150)
  dueDate DateTime @db.Date
  expiryDate DateTime? @db.Date
  cost Decimal? @db.Decimal(12, 2)
  licenseFee Decimal? @db.Decimal(12, 2)
  testFee Decimal? @db.Decimal(12, 2)
  reminderDays Int?
  reminderTime String @default("09:00") @db.VarChar(5)
  notes String @default("") @db.VarChar(2000)
  completedAt DateTime?
  @@index([userId, dueDate])
}
model VehicleExpense {
  washType String @default("") @db.VarChar(30)
  location String @default("") @db.VarChar(200)
  updatedAt DateTime @default(now()) @updatedAt
  nextServiceDate DateTime? @db.Date
  reminderDays Int?
  reminderTime String @default("09:00") @db.VarChar(5)
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(30)
  title String @db.VarChar(150)
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  notes String @default("") @db.VarChar(2000)
  serviceOdometerKm Int?
  ownershipPeriod String @default("UNKNOWN_LEGACY") @db.VarChar(24)
  paidBy String @default("UNKNOWN_LEGACY") @db.VarChar(24)
  totalServiceCost Decimal? @db.Decimal(12, 2)
  userPaidAmount Decimal? @db.Decimal(12, 2)
  sourceProof String @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model NutritionEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(200)
  meal String @db.VarChar(20)
  calories Int
  proteinG Decimal @db.Decimal(8, 1)
  carbsG Decimal @default(0) @db.Decimal(8, 1)
  fatG Decimal @default(0) @db.Decimal(8, 1)
  quantity Decimal @default(1) @db.Decimal(10, 2)
  unit String @default("מנה") @db.VarChar(30)
  barcode String @default("") @db.VarChar(40)
  foodKey String? @db.VarChar(160)
  source String @default("manual") @db.VarChar(30)
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@index([userId, foodKey])
}

model UserFood {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(200)
  brand String @default("") @db.VarChar(120)
  caloriesPer100 Int
  proteinPer100G Decimal @db.Decimal(8, 1)
  carbsPer100G Decimal @db.Decimal(8, 1)
  fatPer100G Decimal @db.Decimal(8, 1)
  barcode String @default("") @db.VarChar(40)
  servingName String @default("מנה") @db.VarChar(40)
  servingGrams Decimal @default(100) @db.Decimal(8, 2)
  aliases String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, name])
  @@index([userId, barcode])
}

model FoodPreference {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodKey String @db.VarChar(160)
  favorite Boolean @default(false)
  useCount Int @default(0)
  lastUsedAt DateTime?
  lastQuantity Decimal? @db.Decimal(10, 2)
  lastUnit String? @db.VarChar(20)
  lastServingGrams Decimal? @db.Decimal(8, 2)
  lastServingName String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, foodKey])
  @@index([userId, favorite, lastUsedAt])
}
model CalendarEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  type String @default("Other") @db.VarChar(30)
  date DateTime @db.Date
  endDate DateTime? @db.Date
  time String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  allDay Boolean @default(false)
  color String @default("#4f7cff") @db.VarChar(7)
  eventTypeId String?
  eventType EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  recurrence Recurrence @default(NONE)
  recurrenceDays Int[] @default([])
  recurrenceUntil DateTime? @db.Date
  reminderMinutes Int?
  notes String @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@index([userId, eventTypeId])
}
model EventType {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(80)
  color String @default("#4f7cff") @db.VarChar(7)
  icon String @default("") @db.VarChar(40)
  defaultDescription String @default("") @db.VarChar(2000)
  defaultDurationMinutes Int?
  defaultReminderMinutes Int?
  createdAt DateTime @default(now())
  events CalendarEvent[]
  @@unique([userId, name])
  @@index([userId])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique @db.Text
  p256dh String @db.Text
  auth String @db.Text
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, enabled])
}
model PushDelivery {
  id String @id @default(cuid())
  subscriptionId String
  occurrenceKey String
  scheduledAtUtc DateTime?
  computedLocalDueAt String? @db.VarChar(80)
  queuedAtUtc DateTime @default(now())
  sentAt DateTime?
  providerAcceptedAt DateTime?
  deliveryResult String? @db.VarChar(40)
  deviceTimezone String? @db.VarChar(64)
  sourceTrigger String? @db.VarChar(40)
  leadMinutes Int @default(0)
  @@unique([subscriptionId, occurrenceKey])
  @@index([sentAt])
}

model WorkSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract Json
}
model WorkEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  type String @db.VarChar(16)
  startedAt DateTime?
  endedAt DateTime?
  breakMinutes Int @default(0)
  pausedAt DateTime?
  overtimeApproved Boolean @default(false)
  distanceKm Decimal @default(0) @db.Decimal(10, 2)
  notes String @default("") @db.VarChar(2000)
  tripId String?
  trip WorkTrip? @relation(fields: [tripId, userId], references: [id, userId], onDelete: NoAction)
  @@unique([id, userId])
  @@index([userId, date])
}
model WorkTrip {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String @db.VarChar(200)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  status String @default("DRAFT") @db.VarChar(16)
  details Json
  entries WorkEntry[]
  expenses WorkExpense[]
  documents WorkDocument[]
  @@unique([id, userId])
  @@index([userId, startDate])
}
model WorkExpense {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId String?
  trip WorkTrip? @relation(fields: [tripId, userId], references: [id, userId], onDelete: NoAction)
  date DateTime @db.Date
  category String @db.VarChar(30)
  amount Decimal @db.Decimal(12, 2)
  currency String @db.VarChar(3)
  exchangeRate Decimal @db.Decimal(14, 6)
  rateDate DateTime @db.Date
  rateSource String @db.VarChar(30)
  paymentSource String @db.VarChar(16)
  reimbursable Boolean @default(false)
  paid Boolean @default(false)
  notes String @default("") @db.VarChar(2000)
  documentId String?
  @@index([userId, date])
}
model WorkDocument {
  documentDate DateTime? @db.Date
  payslipMonth String? @db.VarChar(7)
  uploadSize Int?
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId String?
  trip WorkTrip? @relation(fields: [tripId, userId], references: [id, userId], onDelete: NoAction)
  entryId String?
  name String @db.VarChar(200)
  category String @db.VarChar(20)
  mimeType String @db.VarChar(80)
  content Bytes?
  storageKey String? @unique @db.VarChar(500)
  sha256 String? @db.VarChar(64)
  size Int
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

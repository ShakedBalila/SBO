generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
  CANCELLED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings UserSettings?
  sessions Session[]
  tasks Task[]
  taskEvents TaskEvent[]
  waterEntries WaterEntry[]
  vehicles Vehicle[]
  fuelEntries FuelEntry[]
  nutritionEntries NutritionEntry[]
  calendarEvents CalendarEvent[]
  eventTypes EventType[]
  vehiclePolicies VehiclePolicy[]
  vehicleReminders VehicleReminder[]
  vehicleExpenses VehicleExpense[]
  pushSubscriptions PushSubscription[]
}
model UserSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale String @default("he")
  timezone String @default("Asia/Jerusalem")
  enabledModules String[] @default(["tasks", "water", "car", "nutrition"])
  waterGoalMl Int?
  calorieGoal Int?
  proteinGoalG Int?
  age Int?
  sex String? @db.VarChar(10)
  heightCm Int?
  weightKg Decimal? @db.Decimal(6, 2)
  activityLevel String? @db.VarChar(20)
  weightGoal String? @db.VarChar(20)
  currency String @default("ILS")
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  description String @default("") @db.VarChar(5000)
  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate DateTime? @db.Date
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  recurrence Recurrence @default(NONE)
  recurrenceDays Int[] @default([])
  recurrenceUntil DateTime? @db.Date
  time String? @db.VarChar(5)
  startTime String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  color String? @db.VarChar(7)
  category String? @db.VarChar(80)
  showOnCalendar Boolean @default(false)
  reminderMinutes Int?
  seriesId String?
  completedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status, dueDate])
  @@index([userId, seriesId])
  @@index([userId, deletedAt])
}
model TaskEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  action String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model LoginAttempt {
  key String @id
  count Int @default(1)
  windowStart DateTime @default(now())
}
model WaterEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model Vehicle {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  licensePlate String @default("") @db.VarChar(30)
  year Int?
  odometerKm Int @default(0)
  fuelTankLiters Decimal? @db.Decimal(8, 1)
  createdAt DateTime @default(now())
  fuelEntries FuelEntry[]
  policies VehiclePolicy[]
  reminders VehicleReminder[]
  expenses VehicleExpense[]
  @@unique([id, userId])
  @@index([userId])
}
model FuelEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  date DateTime @db.Date
  estimatedRangeKm Int
  actualDistanceKm Int?
  liters Decimal @db.Decimal(10, 2)
  pricePerLiter Decimal @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model VehiclePolicy {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(20)
  provider String @default("") @db.VarChar(100)
  annualCost Decimal @db.Decimal(12, 2)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  @@index([userId, endDate])
}
model VehicleReminder {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(20)
  title String @db.VarChar(150)
  dueDate DateTime @db.Date
  cost Decimal? @db.Decimal(12, 2)
  notes String @default("") @db.VarChar(2000)
  completedAt DateTime?
  @@index([userId, dueDate])
}
model VehicleExpense {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId, userId], references: [id, userId], onDelete: Cascade)
  type String @db.VarChar(30)
  title String @db.VarChar(150)
  amount Decimal @db.Decimal(12, 2)
  date DateTime @db.Date
  notes String @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model NutritionEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(200)
  meal String @db.VarChar(20)
  calories Int
  proteinG Decimal @db.Decimal(8, 1)
  carbsG Decimal @default(0) @db.Decimal(8, 1)
  fatG Decimal @default(0) @db.Decimal(8, 1)
  quantity Decimal @default(1) @db.Decimal(10, 2)
  unit String @default("מנה") @db.VarChar(30)
  barcode String @default("") @db.VarChar(40)
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([userId, date])
}
model CalendarEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  type String @default("Other") @db.VarChar(30)
  date DateTime @db.Date
  endDate DateTime? @db.Date
  time String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  allDay Boolean @default(false)
  color String @default("#4f7cff") @db.VarChar(7)
  eventTypeId String?
  eventType EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  recurrence Recurrence @default(NONE)
  recurrenceDays Int[] @default([])
  recurrenceUntil DateTime? @db.Date
  reminderMinutes Int?
  notes String @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@index([userId, eventTypeId])
}
model EventType {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(80)
  color String @default("#4f7cff") @db.VarChar(7)
  icon String @default("") @db.VarChar(40)
  defaultDescription String @default("") @db.VarChar(2000)
  defaultDurationMinutes Int?
  defaultReminderMinutes Int?
  createdAt DateTime @default(now())
  events CalendarEvent[]
  @@unique([userId, name])
  @@index([userId])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique @db.Text
  p256dh String @db.Text
  auth String @db.Text
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, enabled])
}
model PushDelivery {
  id String @id @default(cuid())
  subscriptionId String
  occurrenceKey String
  sentAt DateTime @default(now())
  @@unique([subscriptionId, occurrenceKey])
  @@index([sentAt])
}
